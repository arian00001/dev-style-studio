<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.DevStyle" parent="Theme.MaterialComponents.Light.NoActionBar">
    <item name="android:windowBackground">@drawable/bg_screen</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@color/screen</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="colorAccent">@color/limeDeep</item>
    <item name="colorPrimary">@color/ink</item>
    <item name="colorPrimaryVariant">@color/ink</item>
    <item name="colorOnPrimary">@color/card</item>
    <item name="colorSecondary">@color/limeDeep</item>
    <item name="android:textColorPrimary">@color/ink</item>
  </style>

  <style name="Theme.DevStyle.Splash" parent="Theme.DevStyle">
    <item name="android:windowBackground">@drawable/bg_screen</item>
    <item name="android:windowNoTitle">true</item>
  </style>
</resources>