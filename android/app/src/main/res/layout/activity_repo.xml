<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/screen"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="30dp"
    android:paddingRight="22dp"
    android:paddingBottom="34dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.18"
      android:text="REPOSITORY"
      android:textColor="@color/muted"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/repoTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="repository"
      android:textColor="@color/ink"
      android:textSize="26sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/repoSubtitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="owner"
      android:textColor="@color/muted"
      android:textSize="13sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:background="@drawable/bg_card"
      android:orientation="vertical"
      android:padding="18dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Automation"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/buildButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:text="Build APK"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/refreshButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:text="Refresh latest run"
        android:textColor="@color/card"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/apkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:text="Get latest APK"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:background="@drawable/bg_card"
      android:orientation="vertical"
      android:padding="18dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.16"
        android:text="LATEST RUN"
        android:textColor="@color/muted"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/repoStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Checking the latest run..."
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/runStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

      <ProgressBar
        android:id="@+id/repoProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/limeDeep"
        android:visibility="gone" />
    </LinearLayout>

    <TextView
      android:id="@+id/openButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:background="@drawable/bg_button_outline"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:paddingTop="15dp"
      android:paddingBottom="15dp"
      android:text="Open repository on GitHub"
      android:textColor="@color/ink"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>
</ScrollView>
