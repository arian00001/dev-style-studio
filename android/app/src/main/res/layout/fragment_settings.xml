<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/screen"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingTop="22dp"
    android:paddingRight="18dp"
    android:paddingBottom="26dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.18"
      android:text="SETTINGS"
      android:textColor="@color/limeDeep"
      android:textSize="10sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Connections"
      android:textColor="@color/ink"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Keys stay on this device. They are only sent to GitHub, Vercel, Google and your mail server."
      android:textColor="@color/muted"
      android:textSize="12sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:background="@drawable/bg_card"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GitHub access token"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/inputGithub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="ghp_..."
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <TextView
        android:id="@+id/verifyGithub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:text="Test token"
        android:textColor="@color/ink"
        android:textSize="11sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Vercel access token"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/inputVercel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="vercel token"
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Gemini API key"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/inputGemini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="AIza..."
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/bg_card"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24/7 inbox monitor"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/monitorState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Monitor is off."
        android:textColor="@color/muted"
        android:textSize="12sp" />

      <EditText
        android:id="@+id/inputEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="you@gmail.com"
        android:inputType="textEmailAddress"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <EditText
        android:id="@+id/inputAppPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="16-character app password"
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Auto-reply template"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/inputTemplate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="Hi {{from}}, thanks for your message…"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Let Gemini write the reply"
          android:textColor="@color/ink"
          android:textSize="12sp" />

        <Switch
          android:id="@+id/switchAutoReply"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>

      <TextView
        android:id="@+id/monitorButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Start 24/7 monitor"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/batteryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:text="Allow background running"
        android:textColor="@color/ink"
        android:textSize="12sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/saveButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:background="@drawable/bg_button_dark"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:paddingTop="15dp"
      android:paddingBottom="15dp"
      android:text="Save settings"
      android:textColor="@color/card"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>
</ScrollView>