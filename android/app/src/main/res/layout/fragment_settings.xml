<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bg_screen"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingTop="22dp"
    android:paddingRight="18dp"
    android:paddingBottom="26dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.18"
      android:text="SETTINGS"
      android:textColor="@color/limeDeep"
      android:textSize="10sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Connections"
      android:textColor="@color/ink"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Keys stay on this device. They are only sent to GitHub, Vercel, Google, ImgBB and your mail server."
      android:textColor="@color/muted"
      android:textSize="12sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:background="@drawable/bg_card"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GitHub access token"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/inputGithub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="ghp_..."
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <TextView
        android:id="@+id/verifyGithub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:text="Test token"
        android:textColor="@color/ink"
        android:textSize="11sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Vercel access token"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/inputVercel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="vercel token"
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="ImgBB API key (template images)"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/inputImgbb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="imgbb api key"
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Free key from api.imgbb.com — every template image is uploaded there and linked in the mail."
        android:textColor="@color/muted"
        android:textSize="11sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Gemini API key (optional)"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/inputGemini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="AIza..."
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Write replies with Gemini (AI)"
          android:textColor="@color/ink"
          android:textSize="12sp" />

        <Switch
          android:id="@+id/switchUseAi"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>

      <TextView
        android:id="@+id/modeNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/muted"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/bg_card"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24/7 inbox monitor"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/monitorState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Monitor is off."
        android:textColor="@color/muted"
        android:textSize="12sp" />

      <EditText
        android:id="@+id/inputEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="you@gmail.com"
        android:inputType="textEmailAddress"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <EditText
        android:id="@+id/inputAppPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="16-character app password"
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Auto-reply to new mail"
          android:textColor="@color/ink"
          android:textSize="12sp" />

        <Switch
          android:id="@+id/switchAutoReply"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>

      <TextView
        android:id="@+id/monitorButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Start 24/7 monitor"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/batteryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:text="Allow background running"
        android:textColor="@color/ink"
        android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/bg_card"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reply template"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="This exact designed mail goes to every new email. Use {{from}} or {{subject}} to merge the sender details."
        android:textColor="@color/muted"
        android:textSize="11sp" />

      <EditText
        android:id="@+id/inputTplSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="Re: {{subject}}"
        android:inputType="text"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <EditText
        android:id="@+id/inputTplHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="Thanks for reaching out"
        android:inputType="text"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <EditText
        android:id="@+id/inputTplBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="Message body — leave a blank line between paragraphs"
        android:inputType="textMultiLine"
        android:minLines="4"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <EditText
        android:id="@+id/inputTplSign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="— Your name · Your business"
        android:inputType="text"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Template image"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/imgState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="No image yet."
        android:textColor="@color/muted"
        android:textSize="11sp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/addImage"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="@drawable/bg_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:paddingTop="10dp"
          android:paddingBottom="10dp"
          android:text="Upload image"
          android:textColor="@color/ink"
          android:textSize="12sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/clearImage"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginLeft="8dp"
          android:layout_weight="1"
          android:background="@drawable/bg_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:paddingTop="10dp"
          android:paddingBottom="10dp"
          android:text="Remove image"
          android:textColor="@color/ink"
          android:textSize="12sp" />
      </LinearLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Where the image sits"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/posTop"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="@drawable/bg_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:paddingTop="9dp"
          android:paddingBottom="9dp"
          android:text="Header"
          android:textColor="@color/ink"
          android:textSize="11sp" />

        <TextView
          android:id="@+id/posMiddle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginLeft="6dp"
          android:layout_weight="1"
          android:background="@drawable/bg_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:paddingTop="9dp"
          android:paddingBottom="9dp"
          android:text="In body"
          android:textColor="@color/ink"
          android:textSize="11sp" />

        <TextView
          android:id="@+id/posBottom"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginLeft="6dp"
          android:layout_weight="1"
          android:background="@drawable/bg_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:paddingTop="9dp"
          android:paddingBottom="9dp"
          android:text="Footer"
          android:textColor="@color/ink"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/previewTemplate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Preview the mail"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/pushTemplate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Publish template to GitHub"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Publishing writes mail-template.json to your selected repo, so the GitHub cron sends this same template instead of Gemini."
        android:textColor="@color/muted"
        android:textSize="11sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/saveButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:background="@drawable/bg_button_dark"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:paddingTop="15dp"
      android:paddingBottom="15dp"
      android:text="Save settings"
      android:textColor="@color/card"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>
</ScrollView>